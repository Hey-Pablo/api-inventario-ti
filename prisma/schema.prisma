generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Papel {
  ADMIN
  TECNICO
  LEITURA
}
model Usuario {
  id String @id @default(uuid())
  email String @unique
  senhaHash String
  papel Papel
}
model Filial {
  id String @id @default(uuid())
  nome String @unique
  equipamentos Equipamento[]
  origens Movimentacao[] @relation("origem")
  destinos Movimentacao[] @relation("destino")
  relatorios RelatorioFilial[]
}
model Equipamento {
  id String @id @default(uuid())
  nome String
  patrimonio String @unique
  filialId String
  filial Filial @relation(fields: [filialId], references: [id])
  movimentacoes Movimentacao[]
}
model Movimentacao {
  id String @id @default(uuid())
  equipamentoId String
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  origemId String
  origem Filial @relation("origem", fields: [origemId], references: [id])
  destinoId String
  destino Filial @relation("destino", fields: [destinoId], references: [id])
  criadoEm DateTime @default(now())
}

enum TipoLicenca {
  ETIQUETA
  CASE
  KIT_DOCUMENTACAO
  SOFTWARE
}

model Licenca {
  id String @id @default(uuid())
  nome String @unique
  tipo TipoLicenca
  fabricante String
  quantidadeAtual Int @default(0)
  quantidadeMaxima Int
  vencimento DateTime?
  localizacao String?
  observacoes String?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model RelatorioFilial {
  id String @id @default(uuid())
  filialId String
  filial Filial @relation(fields: [filialId], references: [id])
  equipamentosCount Int @default(0)
  equipamentosValor Decimal @default(0)
  licencasCount Int @default(0)
  licencasValor Decimal @default(0)
  movimentacoesLast7Days Int @default(0)
  movimentacoesLast30Days Int @default(0)
  resumo String @default("")
  criadoEm DateTime @default(now())
}
